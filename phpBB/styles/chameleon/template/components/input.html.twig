{#
ui/input.html.twig

Variables:
- type: Input type (default: "text")
- className: Additional classes to append
- attributes: Key-value pairs for HTML attributes (e.g. { 'placeholder': 'Search...', 'disabled': 'disabled' })
#}
{% set type = type|default('text') %}
{% set className = className|default('') %}
{% set attributes = attributes|default({}) %}

{% set base_classes = 'flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm' %}

{% set classes = (base_classes ~ ' ' ~ className)|trim %}

<input type="{{ type }}" class="{{ classes }}" {% for key, value in attributes %}{{ key }}="{{ value }}" {% endfor %}>
